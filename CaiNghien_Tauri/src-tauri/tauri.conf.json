{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cainghien_tauri",
  "version": "1.3.2",
  "identifier": "com.cainghien.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "COSMOS \u2014 CaiNghi\u1ec7n Desktop Suite",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "visible": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset:; connect-src 'self';"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzMzdCOUE3RDlBQzQwMTMKUldRVFFLelpwN2szczJCQTBRSDdqSmUyTkFrTUkrSW5ndVZGVDMrNExtOGhud0dBZW53dkt5MWQK",
      "endpoints": [
        "https://raw.githubusercontent.com/HairBaconGamming/CaiNghien/main/web/public/data/tauri-update.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}