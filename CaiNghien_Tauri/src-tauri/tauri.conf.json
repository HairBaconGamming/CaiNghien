{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cainghien_tauri",
  "version": "1.2.0",
  "identifier": "com.cainghien.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "cainghien_tauri",
        "width": 800,
        "height": 600,
        "visible": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEMjczOTE3M0YxQjEyMzAKUldRd0Vocy9GemtualE2R2hTRW0vSEJqVm9SRHBhbWVHVHZzMkQxeGRhb04xVzFScXlzRzZSSzcK",
      "endpoints": [
        "https://raw.githubusercontent.com/HairBaconGamming/CaiNghien/main/web/public/data/tauri-update.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
